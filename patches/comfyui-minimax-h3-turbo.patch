+def _canonicalize_lora(lora):
+    """Normalize generic ComfyUI LoRA keys without copying payload tensors.
+
+    LightX v1.1 exports the generic namespace as
+    ``diffusion_model.blocks.*`` and includes one scalar ``.alpha`` tensor for
+    every adapter.  The H3 node's local module map is relative to
+    ``diffusion_model`` (``blocks.*``), while the large A/B tensors must remain
+    disk-backed under NoHostMMap.  Rename dictionary entries only; materialize
+    the tiny alpha scalars through the bounded reader because
+    ``comfy.lora.load_lora`` calls ``.item()`` on them.
+    """
+    normalized = {}
+    for raw_name, tensor in lora.items():
+        name = raw_name
+        if name.startswith("diffusion_model."):
+            name = name[len("diffusion_model."):]
+
+        if name.endswith(".alpha") and getattr(tensor, "is_meta", False):
+            tensor = _captured_lora_to_device(tensor, torch.device("cpu"))
+
+        if name in normalized:
+            raise ValueError(f"duplicate canonical LoRA key: {name}")
+        normalized[name] = tensor
+    return normalized
+
+
