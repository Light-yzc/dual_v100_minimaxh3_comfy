+def _captured_lora_to_device(tensor, device):
+    """Materialize one captured LoRA tensor without a host-sized file copy.
+
+    The pruned-base AdaLN path stores LoRA factors in a closure instead of in
+    a module tree, so ComfyUI's normal bypass-adapter move hook cannot see
+    them.  Under H3_NO_HOST_MMAP those factors are meta tensors carrying a
+    disk slice; resolve that slice directly to the owning CUDA device on first
+    use.  The NoHostMMap helper uses bounded CPU staging (8 MiB max).
+    """
+    if not getattr(tensor, "is_meta", False):
+        return tensor.to(device=device)
+
+    from custom_nodes.NoHostMMap.safetensors import _file_slice_tensor_to_device
+
+    loaded = _file_slice_tensor_to_device(tensor, torch.device(device), tensor.dtype)
+    if loaded is None:
+        raise RuntimeError("Turbo LoRA captured a meta tensor without a disk slice")
+    return loaded
+
