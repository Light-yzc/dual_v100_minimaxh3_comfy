+def encoder_names():
+    """Return safetensors and ComfyUI-GGUF text encoder filenames.
+
+    ClipProj's resident Qwen path can consume a header-only GGUF directly,
+    but the node used to advertise only ``text_encoders``.  ComfyUI-GGUF
