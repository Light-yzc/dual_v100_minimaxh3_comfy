+def detect_gguf_arch(path):
+    """Identify the small Qwen-VL GGUF without constructing its payload.
+
+    The resident Q4 route uses the header-only reader and puts raw tensors
+    straight on the requested CUDA device; opening it through gguf.GGUFReader
+    here would reintroduce a full-file mapping before the actual loader runs.
+    """
+    if not path.lower().endswith(".gguf"):
+        return None
+    try:
+        from custom_nodes.NoHostMMap.gguf_reader import NoMmapGGUFReader
+
+        reader = NoMmapGGUFReader(path)
+        arch_field = reader.get_field("general.architecture")
+        if arch_field is None:
+            return None
+        arch = str(arch_field.parts[arch_field.data[-1]], "utf-8")
+        if arch != "qwen3vl":
+            return None
+        token = next((t for t in reader.tensors if t.name == "token_embd.weight"), None)
+        if token is None:
+            return None
+        hidden = int(tuple(reversed(token.shape))[1])
+        return _ARCH_BY_DIM.get(hidden)
+    except Exception as e:
+        logging.debug("[ClipProj] GGUF architecture detection failed: %s", e)
+        return None
+
+
+def qwen_gguf_owner_selector(path, first, second, split):
+    """Return the exact, numerically neutral owner map for Qwen3-VL GGUF.
+
+    The language GGUF and its companion mmproj are separate files.  Vision,
+    embedding and the first ``split`` complete language blocks stay on GPU0;
+    the remaining complete blocks and final language norm go to GPU1.  No
+    matrix is head/channel sharded here, so this preserves the ordinary Qwen
+    forward exactly and avoids the measured drift of strict Qwen TP.
+    """
+    language_path = os.path.realpath(path)
+    first = torch.device(first)
+    second = torch.device(second)
+    split = int(split)
+
+    def select(tensor_name, source_path):
+        if os.path.realpath(source_path) != language_path:
+            return first  # companion vision/mmproj
+        if tensor_name.startswith("blk."):
+            parts = tensor_name.split(".", 2)
+            if len(parts) >= 2 and parts[1].isdigit():
+                return first if int(parts[1]) < split else second
+        if tensor_name.startswith(("output_norm.", "output.")):
+            return second
+        return first  # token embedding and tokenizer-side tensors
+
+    return select
+
