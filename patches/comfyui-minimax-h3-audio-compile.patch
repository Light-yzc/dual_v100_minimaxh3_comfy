+    def _decoder_for_inference(self, x):
+        """Return the cached compiled BigVGAN after it is safe to compile.
+
+        Compilation is deliberately one-shot per VAE instance.  A compiler
+        failure is sticky and falls back to the known-good eager decoder for
+        all later requests, so a bad backend cannot add a cold-start penalty to
+        every generation.  ``default``/static-shape compilation is intentional:
+        the SM70 benchmark showed max-autotune was slower and substantially
+        increased cold-start time.
+        """
+        if not self._h3_audio_compile_enabled or self._h3_audio_compile_failed:
+            return self.decoder
+
+        compiled = self._h3_audio_compiled_decoder
+        if compiled is not None:
+            return compiled
+
+        # The decoder must already be on CUDA.  This guard is both a safety net
+        # for direct callers and what prevents torch.compile from tracing a
+        # CPU/meta model during VAE construction.
+        if not x.is_cuda:
+            return self.decoder
+
+        with self._h3_audio_compile_lock:
+            compiled = self._h3_audio_compiled_decoder
+            if compiled is not None:
+                return compiled
+            if self._h3_audio_compile_attempted:
+                return self.decoder
+
+            self._h3_audio_compile_attempted = True
+            try:
+                compile_mode = os.environ.get("H3_AUDIO_VAE_COMPILE_MODE", "default")
+                if compile_mode not in {"default", "reduce-overhead"}:
+                    raise ValueError(
+                        "H3_AUDIO_VAE_COMPILE_MODE must be default or reduce-overhead"
+                    )
+
+                started = time.perf_counter()
+
+                # DynamicVRAM/AIMDO normally resolves a layer's disk-backed
+                # weight on its first eager call.  Warm the exact decoder once
+                # before tracing so Inductor cannot capture the file-transfer
+                # path as part of the compiled graph.  Keep this reference for
+                # the numerical gate below; precision takes priority over the
+                # one-time cold-start cost.
+                eager_reference = None
+                if self._h3_audio_compile_validate:
+                    with torch.inference_mode():
+                        eager_reference = self.decoder(x.detach().clone())
+                    if not bool(torch.isfinite(eager_reference).all().item()):
+                        raise FloatingPointError(
+                            "eager BigVGAN reference returned a non-finite probe"
+                        )
+
+                compiled = torch.compile(
+                    self.decoder,
+                    mode=compile_mode,
+                    dynamic=False,
+                    fullgraph=False,
+                )
+
+                # Force the first graph build here, while the lock is held. A
+                # failed first call must not leave a half-initialized wrapper
+                # available to another request.  Check finiteness once at the
+                # boundary; production calls then pay no synchronization cost.
+                with torch.inference_mode():
+                    probe = compiled(x.detach().clone())
+                    if not bool(torch.isfinite(probe).all().item()):
+                        raise FloatingPointError(
+                            "compiled BigVGAN returned a non-finite probe"
+                        )
+
+                if eager_reference is not None:
+                    reference = eager_reference.float()
+                    candidate = probe.float()
+                    if reference.shape != candidate.shape:
+                        raise RuntimeError(
+                            "compiled BigVGAN numerical gate shape mismatch: "
+                            f"eager={tuple(reference.shape)} compiled={tuple(candidate.shape)}"
+                        )
+                    delta = candidate - reference
+                    reference_rms = torch.sqrt(torch.mean(reference.square())).clamp_min_(1e-12)
+                    candidate_norm = torch.linalg.vector_norm(candidate).clamp_min_(1e-12)
+                    reference_norm = torch.linalg.vector_norm(reference).clamp_min_(1e-12)
+                    cosine = torch.sum(reference * candidate) / (reference_norm * candidate_norm)
+                    gate = {
+                        "cosine": float(cosine.item()),
+                        "relative_rms": float((torch.sqrt(torch.mean(delta.square())) / reference_rms).item()),
+                        "max_abs": float(delta.abs().max().item()),
+                    }
+                    self._h3_audio_compile_gate = gate
+                    if (
+                        gate["cosine"] < 0.99999
+                        or gate["relative_rms"] > 1e-4
+                        or gate["max_abs"] > 1e-4
+                    ):
+                        raise RuntimeError(
+                            "compiled BigVGAN numerical gate failed: "
+                            f"cosine={gate['cosine']:.8f} "
+                            f"relative_rms={gate['relative_rms']:.6g} "
+                            f"max_abs={gate['max_abs']:.6g}"
+                        )
+                torch.cuda.synchronize(x.device)
+                self._h3_audio_compile_first_call_ms = (
+                    time.perf_counter() - started
+                ) * 1000.0
+
