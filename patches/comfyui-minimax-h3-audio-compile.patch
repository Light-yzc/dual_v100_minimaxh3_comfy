+                # the VAE's state_dict/module tree.  It still owns the exact
+                # decoder object above, so no second parameter copy is made.
+                object.__setattr__(self, "_h3_audio_compiled_decoder", compiled)
+                self._h3_audio_compile_device = x.device
+                logging.info(
+                    "MiniMax H3 audio BigVGAN torch.compile enabled: "
+                    "mode=%s device=%s first_call_ms=%.1f",
+                    compile_mode,
+                    x.device,
+                    self._h3_audio_compile_first_call_ms,
+                )
+                return compiled
+            except Exception as error:
+                self._h3_audio_compile_failed = True
+                object.__setattr__(self, "_h3_audio_compiled_decoder", None)
+                logging.warning(
+                    "MiniMax H3 audio BigVGAN torch.compile failed; "
+                    "falling back to eager for this VAE instance: %s: %s",
+                    type(error).__name__,
+                    error,
+                )
+                return self.decoder
 
